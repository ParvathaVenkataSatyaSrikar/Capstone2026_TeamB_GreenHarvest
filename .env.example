# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real API keys.

# --- LLM providers (at least one recommended for live answers) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# auto = try OpenAI first, then Gemini, then offline KB
# Options: auto | openai | gemini | offline
LLM_PROVIDER=auto
LLM_REQUEST_TIMEOUT_SEC=35

# --- Optional web search (market / scheme context) ---
TAVILY_API_KEY=

# --- Application tuning ---
# Optional alternate password for field_officer and admin (default in code if unset)
STAFF_DEMO_PASSWORD=greenharvest2026
RETRIEVAL_MIN_SCORE=0.35
ESCALATION_CONFIDENCE_THRESHOLD=0.55
SKIP_LLM_INTAKE_WHEN_KEYWORDS=true
